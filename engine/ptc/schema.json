{
  "version": "2.1.0",
  "note": "Generated from ptc-engine/tools.js inputSchema. Keep in sync: node scripts/gen-ptc-schema.cjs",
  "tools": {
    "ops_ptc_inproc": {
      "type": "object",
      "required": [
        "pattern",
        "rewrite"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "description": "AST pattern，如 `return $A`"
        },
        "rewrite": {
          "type": "string",
          "description": "重写模板，如 `return ($A);`"
        },
        "symbol": {
          "type": "string",
          "description": "锁定到该符号体内"
        },
        "file": {
          "type": "string",
          "description": "已知文件，跳过枚举"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "枚举根，默认 cwd"
        },
        "ext": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "默认 ts/tsx"
        },
        "mode": {
          "type": "string",
          "enum": [
            "apply",
            "preview"
          ],
          "description": "默认 apply"
        },
        "limit": {
          "type": "number",
          "description": "最多文件数，默认 1"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "auto",
            "walk",
            "everything"
          ],
          "description": "默认 auto"
        },
        "strict": {
          "type": "boolean",
          "description": "落盘前用 sg CLI 复核命中数，默认 false"
        }
      }
    },
    "ops_ptc_locate": {
      "type": "object",
      "required": [
        "symbol"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "符号名"
        },
        "file": {
          "type": "string",
          "description": "已知文件跳过枚举"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "枚举根，默认 cwd"
        },
        "ext": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "默认 ts/tsx"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "auto",
            "walk",
            "everything"
          ],
          "description": "默认 auto"
        },
        "limit": {
          "type": "number",
          "description": "最多命中文件数，默认 5"
        },
        "body": {
          "type": [
            "boolean",
            "number"
          ],
          "description": "附命中正文：true/缺省 = 总字节 ≤8KiB 才附，false = 只给行号，数字 = 自定义额度。"
        }
      }
    },
    "ops_ptc_refactor": {
      "type": "object",
      "required": [
        "query",
        "symbol",
        "pattern",
        "rewrite"
      ],
      "properties": {
        "query": {
          "type": "string",
          "description": "搜索条件，如 *.ts"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "搜索根"
        },
        "ext": {
          "type": "string",
          "description": "扩展名，如 ts"
        },
        "scope": {
          "type": "string",
          "enum": [
            "cwd",
            "global"
          ],
          "description": "默认 cwd"
        },
        "limit": {
          "type": "number",
          "description": "返回上限，默认 32"
        },
        "file": {
          "type": "string",
          "description": "已知文件跳过寻址"
        },
        "symbol": {
          "type": "string",
          "description": "SANE 目标符号名"
        },
        "pattern": {
          "type": "string",
          "description": "ast-grep pattern，如 \"return true\""
        },
        "rewrite": {
          "type": "string",
          "description": "ast-grep rewrite"
        },
        "mode": {
          "type": "string",
          "enum": [
            "preview",
            "apply"
          ],
          "description": "默认 apply"
        }
      }
    },
    "ops_ptc_find": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ext": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "cwd",
            "global"
          ]
        },
        "limit": {
          "type": "number"
        }
      }
    },
    "ops_ptc_audit": {
      "type": "object",
      "required": [
        "file",
        "beforeFile"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "当前文件"
        },
        "beforeFile": {
          "type": "string",
          "description": "改动前镜像"
        }
      }
    }
  }
}
