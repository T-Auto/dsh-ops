{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "declaration": true,
    "sourceMap": false,
    "newLine": "lf",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ]
}
