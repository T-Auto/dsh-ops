# Local release artifacts and credentials
dist/
# Credential material that must never be committed, whatever a scratch tree contains (#30)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json

# Native worker build output and local audit stores
runtime/
native/target/
.dsh-ops/

# Dependencies
node_modules/

# Compiled plugin source (edit src/ and run npm run build)
/lib/

# Scratch trees used by the suites and by hand
.tmp-*
*.scratch.*
.scratch-*

# Local cross-session handoff, project context and architecture notes
memorybank/

# Editor and OS noise
.DS_Store
Thumbs.db

# Generated by scripts/tools-trial.mjs (uploaded as a CI artifact, never committed)
tools-trial-report.md

# Bench evidence: a run's data is what happened on one machine, not source. Keep it out of the
# repository, and out of a PR's diff, however tempting a green smoke run is to commit.
bench/runs/
# The operator's local overlay for a sweep (their own model/token settings). Per-machine, never shared.
bench/llm.patch.yml
# Update-lock sidecars the CLI leaves next to whatever it rewrites (also seen under test/).
*.dsh-ops-update-*.lock
