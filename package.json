{
  "name": "dsh-ops",
  "version": "0.3.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Auto/dsh-ops.git"
  },
  "homepage": "https://github.com/T-Auto/dsh-ops#readme",
  "bugs": {
    "url": "https://github.com/T-Auto/dsh-ops/issues"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "description": "Native file and PTC tools for DSH on Windows x64, Linux x64 and macOS Apple Silicon; Windows-only optional Bash and PowerShell 7 payloads",
  "icon": "./docs/assets/icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "repository-tools"
  ],
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./policy": {
      "default": "./lib/policy.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./shell": {
      "default": "./lib/components/shell/index.js"
    },
    "./shell/package.json": "./lib/components/shell/package.json",
    "./shell/locale/*.json": "./lib/components/shell/locale/*.json",
    "./file": {
      "default": "./lib/components/file/index.js"
    },
    "./file/package.json": "./lib/components/file/package.json",
    "./file/locale/*.json": "./lib/components/file/locale/*.json",
    "./background": {
      "default": "./lib/components/background/index.js"
    },
    "./background/package.json": "./lib/components/background/package.json",
    "./background/locale/*.json": "./lib/components/background/locale/*.json",
    "./ptc": {
      "default": "./lib/components/ptc/index.js"
    },
    "./ptc/package.json": "./lib/components/ptc/package.json",
    "./ptc/locale/*.json": "./lib/components/ptc/locale/*.json",
    "./tui": {
      "default": "./lib/components/tui/index.js"
    },
    "./tui/package.json": "./lib/components/tui/package.json",
    "./tui/locale/*.json": "./lib/components/tui/locale/*.json",
    "./hide-official": {
      "default": "./lib/components/hide-official/index.js"
    },
    "./hide-official/package.json": "./lib/components/hide-official/package.json",
    "./hide-official/locale/*.json": "./lib/components/hide-official/locale/*.json"
  },
  "bin": {
    "dsh-ops": "bin/dsh-ops.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "docs/assets/icon.png",
    "locale",
    "docs",
    "LICENSE",
    "NOTICE",
    "licenses",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "docs/PROVENANCE.md",
    "docs/CHANGELOG.md",
    "runtime",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "native/windows-metadata",
    "native/darwin-metadata",
    "native/bash-ipc"
  ],
  "scripts": {
    "build:bash-ipc": "node bin/build-bash-ipc.mjs",
    "build:ptc": "node bin/dsh-ops.mjs build-ptc",
    "stage:ptc": "node bin/native-runtime.mjs stage",
    "check:ptc-runtime": "node bin/native-runtime.mjs check --staged",
    "test:ptc": "node test/run.mjs ptc",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "node test/run.mjs",
    "verify:release": "npm run verify && node bin/check-release.mjs",
    "verify": "node scripts/validate-manifest.mjs && node test/run.mjs",
    "bench:setup": "node bench/setup.mjs",
    "bench:baseline": "bench\\platform\\win-ab.bat"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@dsh-ops/bash-win32-x64": "0.2.1",
    "@dsh-ops/pwsh-win32-x64": "0.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@dsh-std/manifest": "0.1.1-rc.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
