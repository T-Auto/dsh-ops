{
  "name": "dsh-ops",
  "version": "0.4.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Auto/dsh-ops.git"
  },
  "homepage": "https://github.com/T-Auto/dsh-ops#readme",
  "bugs": {
    "url": "https://github.com/T-Auto/dsh-ops/issues"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "description": "Native file and PTC tools for DSH on Windows x64, Linux x64 and macOS arm64/x64; Windows-only optional Bash payload and host PowerShell integration",
  "icon": "./docs/assets/icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "repository-tools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./policy": {
      "default": "./lib/policy.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./shell": {
      "default": "./lib/components/shell/index.js"
    },
    "./shell/package.json": "./lib/components/shell/package.json",
    "./shell/locale/*.json": "./lib/components/shell/locale/*.json",
    "./file": {
      "default": "./lib/components/file/index.js"
    },
    "./file/package.json": "./lib/components/file/package.json",
    "./file/locale/*.json": "./lib/components/file/locale/*.json",
    "./background": {
      "default": "./lib/components/background/index.js"
    },
    "./background/package.json": "./lib/components/background/package.json",
    "./background/locale/*.json": "./lib/components/background/locale/*.json",
    "./ptc": {
      "default": "./lib/components/ptc/index.js"
    },
    "./ptc-sdk": {
      "types": "./lib/ptc/sdk.d.ts"
    },
    "./ptc/package.json": "./lib/components/ptc/package.json",
    "./ptc/locale/*.json": "./lib/components/ptc/locale/*.json",
    "./panel": {
      "default": "./lib/components/panel/index.js"
    },
    "./panel/package.json": "./lib/components/panel/package.json",
    "./panel/locale/*.json": "./lib/components/panel/locale/*.json",
    "./panel/icon": "./lib/components/panel/icon.png",
    "./tui": {
      "default": "./lib/components/tui/index.js"
    },
    "./tui/package.json": "./lib/components/tui/package.json",
    "./tui/locale/*.json": "./lib/components/tui/locale/*.json",
    "./discovery": {
      "default": "./lib/components/discovery/index.js"
    },
    "./discovery/package.json": "./lib/components/discovery/package.json",
    "./discovery/locale/*.json": "./lib/components/discovery/locale/*.json",
    "./hide-official": {
      "default": "./lib/components/hide-official/index.js"
    },
    "./hide-official/package.json": "./lib/components/hide-official/package.json",
    "./hide-official/locale/*.json": "./lib/components/hide-official/locale/*.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "bin": {
    "dsh-ops": "bin/dsh-ops.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "docs/assets/icon.png",
    "locale",
    "docs",
    "LICENSE",
    "NOTICE",
    "licenses",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "docs/PROVENANCE.md",
    "docs/CHANGELOG.md",
    "runtime",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "native/crates",
    "native/windows-metadata",
    "native/darwin-metadata",
    "native/bash-ipc"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "pretest:ptc": "node scripts/build.mjs",
    "typecheck": "tsc -p . --noEmit",
    "build:bash-ipc": "node bin/build-bash-ipc.mjs",
    "build:ptc": "node bin/dsh-ops.mjs build-ptc",
    "stage:ptc": "node bin/native-runtime.mjs stage",
    "check:ptc-runtime": "node bin/native-runtime.mjs check --staged",
    "test:ptc": "node test/run.mjs ptc",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "test": "node test/run.mjs",
    "verify:release": "npm run verify && node bin/check-release.mjs",
    "verify": "node scripts/build.mjs && node scripts/validate-manifest.mjs && node test/run.mjs",
    "bench:cli": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --",
    "bench:setup": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs','setup',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --",
    "bench:ab": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs','ab',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --",
    "bench:report": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs','report',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --",
    "bench:panel": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs','panel',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --",
    "bench:tools": "node -e \"const fs=require('node:fs');if(!fs.existsSync('bench/cli.mjs')){console.error('bench/ is repository-only and never shipped in the npm package (bench 只存在于仓库,不随包发布); run npm run bench:* from a dsh-ops checkout');process.exit(2)};process.exit(require('node:child_process').spawnSync(process.execPath,['bench/cli.mjs','tools',...process.argv.slice(1)],{stdio:'inherit'}).status??1)\" --"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@dsh-ops/bash-win32-x64": "0.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@dsh-std/manifest": "0.1.1-rc.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "js-tiktoken": "1.0.21",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
